[Unit]
Description=Fox Watch night camera recorder
Wants=systemd-time-wait-sync.service
After=time-sync.target systemd-time-wait-sync.service

[Service]
Type=simple
User=rob
EnvironmentFile=/etc/foxcam.env
ExecStart=/opt/foxcam-pi/record.sh
Restart=on-failure
RestartSec=10
KillMode=control-group
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target

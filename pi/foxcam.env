START_TIME=19:00
STOP_TIME=07:00
# ALWAYS_ON=1 records around the clock and ignores the window; START_TIME still names the night boundary on the VPS.
ALWAYS_ON=0
TZ=Europe/London
# Indoor starting values; calibrate exposure and gain against the installed IR flood. 0 means automatic, needed for daytime recording.
SHUTTER_US=20000
GAIN=4
# Fixed monochrome IR starting value; calibrate under the installed 850 nm flood.
AWB_GAINS=1.0,1.0
# H.264 bitrate cap in bits per second; must stay well under the Wi-Fi upload rate (about 6 Mbit/s measured).
BITRATE=3000000
WIDTH=1280
HEIGHT=720
# Extra rpicam-vid flags. Camera Module 3: --autofocus-mode manual --lens-position 0 fixes focus at infinity so autofocus cannot hunt in the dark.
CAMERA_ARGS=--denoise cdn_hq
RECORDINGS_DIR=/home/rob/foxcam-recordings
VPS_HOST=root@62.238.55.235
SSH_PORT=22
# Placeholder only: Task 8 creates this dedicated key and installs its restricted receiver.
SSH_KEY=/home/rob/.ssh/foxcam_ed25519

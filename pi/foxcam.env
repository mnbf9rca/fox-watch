START_TIME=19:00
STOP_TIME=07:00
# ALWAYS_ON=1 records around the clock and ignores the window; START_TIME still names the night boundary on the VPS.
ALWAYS_ON=0
TZ=Europe/London
# Indoor starting values; calibrate exposure and gain against the installed IR flood. 0 means automatic, needed for daytime recording.
SHUTTER_US=20000
GAIN=4
# Fixed white balance gains, for example 1.0,1.0; leave empty for automatic white balance, which looks more natural by day.
AWB_GAINS=1.0,1.0
# H.264 bitrate cap in bits per second. 10 Mbit/s suits the wired link; on Wi-Fi keep it well under the measured upload rate (about 6 Mbit/s).
BITRATE=10000000
WIDTH=1920
HEIGHT=1080
# Extra rpicam-vid flags. --mode 2304:1296 selects the full-field binned sensor mode; without it rpicam picks the cropped 1536x864 mode, which sees about two thirds of the width. 1920x1080 is the Pi 4 H.264 encoder's limit. Camera Module 3: --autofocus-mode manual --lens-position 0 fixes focus at infinity so autofocus cannot hunt in the dark.
CAMERA_ARGS="--mode 2304:1296:10:P --profile high --level 4.2 --denoise cdn_hq"
RECORDINGS_DIR=/home/rob/foxcam-recordings
VPS_HOST=root@62.238.55.235
SSH_PORT=22
# Placeholder only: Task 8 creates this dedicated key and installs its restricted receiver.
SSH_KEY=/home/rob/.ssh/foxcam_ed25519

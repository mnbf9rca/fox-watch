# Catalog IDs confirmed by the orchestrator on 2026-09-28.
# Live answers in tests/fixtures/SOURCES.md.
# Together excluded: VL models need dedicated endpoints; serverless Qwen3.5 rejects multiple images.
# https://inference-api.nousresearch.com/v1/models
# https://api.deepinfra.com/v1/openai/models
# https://api.together.ai/v1/models
MODELS=nous/google/gemini-3.5-flash-lite,nous/openai/gpt-5.4-mini,deepinfra/Qwen/Qwen3-VL-30B-A3B-Instruct
PRIMARY_MODEL=nous/google/gemini-3.5-flash-lite
NOUS_BASE_URL=https://inference-api.nousresearch.com/v1
DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai
TOGETHER_BASE_URL=https://api.together.ai/v1
DATA_DIR=/data/foxcam
MODEL_DIR=/opt/foxcam/models
WORKERS=4
GAP_SECONDS=3
PAD_SECONDS=2
RETAIN_NIGHTS=180
MIN_FREE_GB=10
# Area at 640-pixel scan width; a 25x12 cm target at 9 m spans about 90 pixels squared.
MIN_BLOB_AREA=25
# Minimum centroid-bounds diagonal / mean max(box width, height); always at least 20 pixels.
MIN_TRACK_MOVE_RATIO=0.75
EDGE_MARGIN=120
START_TIME=19:00
STOP_TIME=07:00
TZ=Europe/London

# Fixed mounted full-field camera; refit after moving it. Ground estimates are metres.
# Local checkout: set GROUND_CALIBRATION=vps/ground-calibration.json after sourcing.
GROUND_CALIBRATION=/opt/foxcam/vps/ground-calibration.json
